        "cards": [
          {
            "icon": "ph ph-lightning",
            "label": {
              "nl": "Doorzettingsvermogen",
              "en": "Persistence"
            },
            "text": {
              "nl": "Ik word gedreven door <strong>nieuwsgierigheid en doorzettingsvermogen</strong>. Wanneer een uitdaging echt mijn interesse wekt, ben ik vastberaden om de juiste oplossing te vinden.",
              "en": "I’m fueled by <strong>curiosity and persistence</strong>. When a challenge truly catches my interest, I’m determined to find the right solution for it."
            }
          },
          {
            "icon": "ph ph-shield-check",
            "label": {
              "nl": "Systeembetrouwbaarheid",
              "en": "System Reliability"
            },
            "text": {
              "nl": "Toegewijd aan een schone architectuur en voorspelbare uitvoering. Ik neem verantwoordelijkheid voor het volledige proces, van het initiële protocolontwerp tot de hardware-implementatie.",
              "en": "Committed to clean architecture and predictable execution. I take end-to-end ownership from initial protocol design down to hardware implementation."
            }
          },
          {
            "icon": "ph ph-cpu",
            "label": {
              "nl": "Hardware-Software Synergie",
              "en": "Hardware-Software Synergy"
            },
            "text": {
              "nl": "Gefascineerd door wat er onder de abstractielaag gebeurt — van CAN-busprotocollen in voertuigen tot microcontrollerregisters en realtime sensorverwerking.",
              "en": "Fascinated by what happens beneath the abstraction layer — from vehicle CAN bus protocols to micro-controller registers and real-time sensor processing."
            }
          }
        ]
      }
